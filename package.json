{
  "name": "personal-agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "smoke": "node scripts/smoke-demo.mjs",
    "smoke:aliyun": "tsx scripts/smoke-aliyun.ts",
    "smoke:aliyun:skill": "tsx scripts/smoke-aliyun-skill.ts",
    "inspect:aliyun:collections": "tsx scripts/inspect-aliyun-collections.ts",
    "format": "prettier --write src test scripts",
    "test:deepseek": "node scripts/smoke-deepseek.mjs",
    "test:deepseek:capabilities": "node scripts/smoke-deepseek-capabilities.mjs",
    "bench:store:reads": "node scripts/bench-store-reads.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "verify:vendor:upstream": "node scripts/verify-vendor.mjs --upstream",
    "migrate:prod": "node dist/migrate.js",
    "skills:deliver": "tsx src/config/deliver.ts",
    "skills:deliver:prod": "node dist/config/deliver.js",
    "config:import": "tsx src/config/cli.ts",
    "config:import:prod": "node dist/config/cli.js",
    "smoke:compose": "node scripts/smoke-compose.mjs"
  },
  "dependencies": {
    "@cubesandbox/sdk": "file:vendor/cubesandbox-sdk-0.3.0.tgz",
    "@earendil-works/pi-coding-agent": "file:vendor/pi-coding-agent-0.99.2-harness-security.tgz",
    "@fastify/multipart": "10.1.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ali-oss": "6.23.0",
    "cron-parser": "5.4.0",
    "e2b": "2.31.0",
    "fastify": "5.12.8",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "typebox": "1.3.27",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.4",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/yauzl": "3.4.0",
    "playwright-core": "1.64.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
