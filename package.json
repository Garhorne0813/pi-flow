{
  "name": "enterprise-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "smoke": "node scripts/smoke-demo.mjs",
    "format": "prettier --write src test scripts",
    "test:deepseek": "node scripts/smoke-deepseek.mjs"
  },
  "dependencies": {
    "@cubesandbox/sdk": "file:vendor/cubesandbox-sdk-0.3.0.tgz",
    "@earendil-works/pi-coding-agent": "file:vendor/pi-coding-agent-0.99.2-harness.tgz",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.5",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "typebox": "1.3.27",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
