# Public OIDC metadata only. Requires a registered public PKCE client.
VITE_OIDC_AUTHORITY=https://identity.example.com
VITE_OIDC_CLIENT_ID=pi-flow-chat
VITE_OIDC_SCOPE=openid profile
# Development proxy, not bundled into the frontend:
CHAT_API_TARGET=http://127.0.0.1:3000
# CHAT_DEV_TOKEN=development-only-token
