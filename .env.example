# Production: provide real values. Do not commit a populated .env.
HARNESS_MODE=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://harness:replace-me@postgres:5432/harness
INLINE_WORKER=false
WORKER_CONCURRENCY=4
SANDBOX_MAX_ACTIVE_PER_USER=3
SANDBOX_MAX_ACTIVE_TOTAL=100
SANDBOX_IDLE_PAUSE_SECONDS=900
SANDBOX_IDLE_RELEASE_SECONDS=86400
SANDBOX_SWEEP_INTERVAL_SECONDS=60
SANDBOX_MAX_SNAPSHOTS_PER_WORKSPACE=20
UCS_JWKS_URL=https://ucs.example/.well-known/jwks.json
UCS_ISSUER=https://ucs.example
UCS_AUDIENCE=enterprise-harness
LLM_PROVIDER=enterprise
LLM_MODEL_ID=coding-model
LLM_BASE_URL=https://llm.example/v1
LLM_API_KEY=replace-me
CUBE_API_URL=https://cube.example
CUBE_API_KEY=replace-me
CUBE_TEMPLATE_ID=tpl-replace-me
CUBE_VOLUME_DRIVER=nfs
CUBE_EXEC_USER=sandbox
CUBE_PROXY_SCHEME=https
CUBE_PROXY_PORT_HTTP=443
CUBE_SANDBOX_DOMAIN=cube.example
# Bundles are tenant permission groups; bundle values are labels, not mounted volumes.
SKILL_BUNDLES_JSON={"default":"default"}
# One immutable volume per skill version. Its root holds only this skill's SKILL.md and auxiliary files.
SKILL_VOLUMES_JSON={"review@v1":{"bundle":"default","path":"/skills/review/v1/SKILL.md","volume":"skill-review-v1"}}
MCP_ENDPOINTS_JSON={"knowledge-base":{"url":"https://mcp.example/mcp","tokenEnv":"MCP_KB_TOKEN"}}
MCP_KB_TOKEN=replace-me

# Explicit per-tenant upper bounds; a tenant cannot reference another tenant's bundle or endpoint.
TENANT_CAPABILITIES_JSON={"enterprise-tenant":{"bundles":["default"],"endpoints":["knowledge-base"]}}
