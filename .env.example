# Production: provide real values. Do not commit a populated .env.
HARNESS_MODE=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://harness:replace-me@postgres:5432/harness
INLINE_WORKER=false
WORKER_CONCURRENCY=4
SANDBOX_MAX_ACTIVE_PER_USER=3
SANDBOX_MAX_ACTIVE_TOTAL=100
SANDBOX_IDLE_PAUSE_SECONDS=900
SANDBOX_IDLE_RELEASE_SECONDS=86400
SANDBOX_SWEEP_INTERVAL_SECONDS=60
SANDBOX_MAX_SNAPSHOTS_PER_WORKSPACE=20
UCS_JWKS_URL=https://ucs.example/.well-known/jwks.json
UCS_ISSUER=https://ucs.example
UCS_AUDIENCE=enterprise-harness
# Isolated deployments without UCS may explicitly set DEV_TOKEN (16+ chars).
# This fixed token always grants admin access; use UCS OIDC for untrusted clients.
# DEV_TOKEN=replace-with-a-random-secret
# DEV_TENANT_ID=local
# DEV_USER_ID=local-admin
LLM_PROVIDER=enterprise
LLM_MODEL_ID=coding-model
LLM_BASE_URL=https://llm.example/v1
LLM_API_KEY=replace-me
# Plain HTTP is rejected unless an isolated deployment explicitly opts in.
# LLM_ALLOW_HTTP=true
CUBE_API_URL=https://cube.example
CUBE_API_KEY=replace-me
CUBE_TEMPLATE_ID=tpl-replace-me
CUBE_VOLUME_DRIVER=nfs
CUBE_EXEC_USER=sandbox
CUBE_PROXY_SCHEME=https
CUBE_PROXY_PORT_HTTP=443
CUBE_SANDBOX_DOMAIN=cube.example
# Legacy Cube bundle labels; values are labels, not mounted volumes.
SKILL_BUNDLES_JSON={"default":"default"}
# Default: one immutable host directory per skill version, mounted read-only.
# Its root holds only this skill's SKILL.md and auxiliary files.
SKILL_VOLUMES_JSON={"review@v1":{"bundle":"default","path":"/skills/review/v1/SKILL.md","hostPath":"/data/agent-skills/review"}}
# Default approved root. Use canonical paths without trailing slashes; [] disables host sources.
# Host mode requires the same filesystem at the same path in API, Workers and Cubelet.
# Also allow /data/agent-skills/ in CubeMaster's allowed_host_mount_prefixes.
SKILL_HOST_ROOTS_JSON=["/data/agent-skills"]
# Console ZIP uploads default to the first approved host root. Provision its
# uploads/ subdirectory writable by the API; Workers/Cubelet must see the same
# filesystem/path. Uploaded versions need no SKILL_VOLUMES_JSON entry/restart.
# Set explicitly if multiple roots are configured (must be inside an approved root).
# SKILL_UPLOAD_ROOT=/data/agent-skills
# Optional volume backend (may be mixed with hostPath bindings):
# SKILL_VOLUMES_JSON={"review@v1":{"bundle":"default","path":"/skills/review/v1/SKILL.md","volume":"skill-review-v1"}}
MCP_ENDPOINTS_JSON={"knowledge-base":{"url":"https://mcp.example/mcp","tokenEnv":"MCP_KB_TOKEN"}}
MCP_KB_TOKEN=replace-me

# Personal platform
# Optional directory import only; not read by API/Worker startup.
# CONFIG_DIR=config
SANDBOX_PROVIDER=cube
# Aliyun Agent Sandbox 极速版 (SANDBOX_PROVIDER=aliyun): Cube variables are
# not required. Remove SKILL_VOLUMES_JSON above (or set it to {}). See
# docs/aliyun-sandbox.md for OSS/RAM/template prerequisites and limitations.
# E2B_API_KEY=replace-me
# E2B_API_URL=https://api.cn-hangzhou.sandbox.aliyuncs.com
# E2B_DOMAIN=cn-hangzhou.sandbox.aliyuncs.com
# ALIYUN_TEMPLATE_ID=pi-flow-v1
# ALIYUN_EXEC_USER=user
# ALIYUN_TIMEOUT_MS=900000
# ALIYUN_OSS_BUCKET=your-workspace-bucket
# ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# ALIYUN_OSS_ROLE_ARN=acs:ram::1234567890123456:role/pi-flow-sandbox
# ALIYUN_OSS_WORKSPACE_PREFIX=/pi-flow/workspaces
# Same upload prefix on API/Workers; only API needs publication credentials.
# API needs credentials for ZIP and collection publication; Workers use the internal API.
# ALIYUN_OSS_SKILL_UPLOAD_PREFIX=/pi-flow/skill-uploads
# ALIYUN_OSS_SKILL_COLLECTION_PREFIX=/pi-flow/skill-collections
# Shared machine token on API/Workers; never expose it to browser clients.
# ALIYUN_SKILL_COLLECTION_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Worker: API origin (remote HTTPS or loopback HTTP only).
# ALIYUN_SKILL_COLLECTION_API_URL=https://pi-flow-internal.example.com
# ALIYUN_OSS_REGION=oss-cn-hangzhou
# ALIYUN_OSS_ACCESS_KEY_ID=replace-me
# ALIYUN_OSS_ACCESS_KEY_SECRET=replace-me
# ALIYUN_OSS_SECURITY_TOKEN=optional-sts-token
# ALIYUN_ALLOW_INTERNET_ACCESS=false
# The exact <bucket>.<endpoint-host> storage target is automatically allowed.
# Explicitly denying that domain without an allow entry rejects configuration.
# ALIYUN_NETWORK_JSON={"allowOut":["your-workspace-bucket.oss-cn-hangzhou.aliyuncs.com","api.example.com"],"denyOut":["blocked.example.com"]}
# Publish immutable SKILL.md and auxiliary files under each OSS bucketPath.
# ALIYUN_SKILLS_JSON={"review@v1":{"bundle":"default","path":"/skills/review/v1/SKILL.md","bucketPath":"/pi-flow/skills/review/v1"}}
SCHEDULES_ENABLED=false
# DEV_SUBJECT=local-admin
# OIDC administrator subjects and additional trusted JWT roles.
# UCS_ADMIN_USER_IDS=user-a,user-b
# UCS_ADMIN_ROLE_KEYS=platform-admin
# Base64 encoded 32-byte random keys, shared by API and all Workers.
# CONFIG_SECRET_KEY=...
# RUN_TOKEN_KEY=...
# Optional Skill materialization target; mount it read-only through the Provider.
# SKILL_DELIVER_DIR=/var/lib/pi-flow/skills
# Optional search endpoint; receives a q query parameter.
# WEB_SEARCH_URL=https://search.example/search
